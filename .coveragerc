[run]
source = .
omit =
    tests/*
    __pycache__/*
    */__pycache__/*
    .venv/*
    venv/*
    setup.py
    HuggXet-Downloader.spec
    downloaders/xet_downloader.py
    pyscript
    shibokensupport/*
    signature_bootstrap.py

[report]
precision = 2
show_missing = true
skip_covered = false
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:

[html]
directory = htmlcov
